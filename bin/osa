#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["click==8.3.3"]
# ///
"""Generic AppleScript/JXA bridge for macOS scriptable applications.

macOS exposes inter-application automation through Apple Events; every app that
ships a scripting definition (`.sdef`) or sets `NSAppleScriptEnabled` can be
driven from the outside. This CLI is a thin, safe wrapper over the system
`osascript` and `sdef` tools so an agent can (1) discover which installed apps
are scriptable, (2) read an app's vocabulary on demand instead of guessing, and
(3) execute AppleScript or JavaScript-for-Automation against them.

The wrapper deliberately holds no per-app knowledge: the source of truth is each
app's own dictionary, fetched live via `osa dict`. Irreversible operations are
gated behind an explicit `--write` flag so a read-oriented call can never
silently delete or shell out.
"""

from __future__ import annotations

import json
import logging
import plistlib
import re
import subprocess
import sys
from pathlib import Path

import click

# Diagnostics go to stderr; the command result is the only thing on stdout so
# the CLI composes cleanly in pipelines.
logging.basicConfig(
    level=logging.WARNING, format="%(levelname)s: %(message)s", stream=sys.stderr
)
log = logging.getLogger("osa")

# Bundle directories scanned for installed applications. CoreServices holds the
# faceless scripting powerhouses (System Events, Finder) amid hundreds of system
# agents, so it is filtered against an allowlist unless --all is given.
APP_DIRS = [
    Path("/Applications"),
    Path("/Applications/Utilities"),
    Path("/System/Applications"),
    Path("/System/Applications/Utilities"),
    Path.home() / "Applications",
]
CORESERVICES = Path("/System/Library/CoreServices")
# The only CoreServices bundles worth surfacing by default — the rest are login
# agents and UI daemons that happen to carry a tiny dictionary.
CORESERVICES_ALLOW = {
    "System Events",
    "Finder",
    "Image Events",
    "Database Events",
    "Shortcuts Events",
    "AppleScript Utility",
}

# Irreversible / outbound-to-shell verbs. Their presence in a script requires an
# explicit --write so a read call cannot destroy data or escape to the shell.
# `set`/`send`/`make` are intentionally absent: they are too common (local
# assignment) or are outbound actions the calling agent confirms at its own
# layer, not data-destroying on their own.
DESTRUCTIVE = re.compile(
    r"\b(delete|empty|erase|to\s+trash|do\s+shell\s+script|eject|"
    r"restart\s+computer|shut\s+down)\b",
    re.IGNORECASE,
)


def _is_scriptable(app: Path) -> bool:
    """An app is scriptable if it ships an .sdef or opts in via Info.plist."""
    info = app / "Contents" / "Info.plist"
    if not info.is_file():
        return False
    resources = app / "Contents" / "Resources"
    if resources.is_dir() and any(resources.glob("*.sdef")):
        return True
    try:
        with info.open("rb") as fh:
            plist = plistlib.load(fh)
    except (OSError, plistlib.InvalidFileException):
        return False
    if "OSAScriptingDefinition" in plist:
        return True
    flag = plist.get("NSAppleScriptEnabled")
    # The key is sometimes a real bool, sometimes the string "YES".
    return flag is True or (isinstance(flag, str) and flag.lower() in {"yes", "true", "1"})


def _scriptable_apps(include_all: bool) -> list[str]:
    """Return sorted unique names of scriptable apps across the scan dirs."""
    names: set[str] = set()
    for d in APP_DIRS:
        if not d.is_dir():
            continue
        for app in d.glob("*.app"):
            if _is_scriptable(app):
                names.add(app.stem)
    if CORESERVICES.is_dir():
        for app in CORESERVICES.glob("*.app"):
            if not _is_scriptable(app):
                continue
            if include_all or app.stem in CORESERVICES_ALLOW:
                names.add(app.stem)
    return sorted(names, key=str.lower)


def _resolve_app_path(name: str) -> Path | None:
    """Resolve an app name to its bundle path via Launch Services, then fall
    back to a case-insensitive scan so partial names ('chrome') still work."""
    try:
        out = subprocess.run(
            ["osascript", "-e", f'POSIX path of (path to application "{name}")'],
            capture_output=True,
            text=True,
            timeout=15,
        )
        if out.returncode == 0 and out.stdout.strip():
            return Path(out.stdout.strip())
    except (subprocess.SubprocessError, OSError) as exc:
        log.debug("path to application failed: %s", exc)
    needle = name.lower()
    for d in [*APP_DIRS, CORESERVICES]:
        if not d.is_dir():
            continue
        for app in d.glob("*.app"):
            if needle in app.stem.lower():
                return app
    return None


def _run_osascript(script: str, language: str) -> subprocess.CompletedProcess:
    """Execute a script by feeding it to osascript on stdin."""
    cmd = ["osascript"]
    if language == "javascript":
        cmd += ["-l", "JavaScript"]
    return subprocess.run(cmd, input=script, capture_output=True, text=True)


@click.group(context_settings={"help_option_names": ["-h", "--help"]})
def cli() -> None:
    """Drive macOS scriptable apps via AppleScript / JavaScript-for-Automation."""


@cli.command()
@click.option("--all", "include_all", is_flag=True, help="Include faceless CoreServices agents too.")
@click.option("--json", "as_json", is_flag=True, help="Emit a JSON array.")
def apps(include_all: bool, as_json: bool) -> None:
    """List scriptable applications installed on this machine."""
    found = _scriptable_apps(include_all)
    if as_json:
        click.echo(json.dumps(found))
    else:
        for name in found:
            click.echo(name)


@cli.command()
@click.argument("app")
@click.option("--raw", is_flag=True, help="Print the full sdef XML instead of a summary.")
def dict(app: str, raw: bool) -> None:
    """Show an app's scripting vocabulary (commands and classes).

    Use this before writing a script against an app you don't know — it is the
    authoritative list of what the app can do, straight from its dictionary.
    """
    path = _resolve_app_path(app)
    if path is None:
        raise click.ClickException(f"Could not locate an app matching {app!r}.")
    try:
        sdef = subprocess.run(
            ["sdef", str(path)], capture_output=True, text=True, timeout=30
        )
    except (subprocess.SubprocessError, OSError) as exc:
        raise click.ClickException(f"sdef failed: {exc}") from exc
    if sdef.returncode != 0:
        raise click.ClickException(f"{path.name} has no scripting dictionary.")
    if raw:
        click.echo(sdef.stdout)
        return
    _summarize_sdef(sdef.stdout, path.name)


def _summarize_sdef(xml: str, app_name: str) -> None:
    """Print a compact per-suite list of commands and classes from sdef XML."""
    import xml.etree.ElementTree as ET

    try:
        root = ET.fromstring(xml)
    except ET.ParseError as exc:
        raise click.ClickException(f"Could not parse dictionary: {exc}") from exc

    click.echo(f"# {app_name} scripting dictionary\n")
    for suite in root.iter("suite"):
        commands = suite.findall("command")
        classes = suite.findall("class")
        if not commands and not classes:
            continue
        click.echo(f"## {suite.get('name', 'suite')}")
        for cmd in commands:
            desc = cmd.get("description", "")
            click.echo(f"  command  {cmd.get('name')}" + (f"  — {desc}" if desc else ""))
        for cls in classes:
            desc = cls.get("description", "")
            props = [p.get("name") for p in cls.findall("property")]
            line = f"  class    {cls.get('name')}"
            if props:
                line += f"  (props: {', '.join(p for p in props if p)})"
            click.echo(line + (f"  — {desc}" if desc else ""))
        click.echo("")


def _read_script(script: str | None, file: str | None) -> str:
    """Resolve script text from an argument, a file, or stdin."""
    if file:
        return Path(file).read_text()
    if script is not None:
        return script
    if not sys.stdin.isatty():
        return sys.stdin.read()
    raise click.ClickException("No script provided (pass an argument, -f FILE, or stdin).")


def _guard(script: str, write: bool) -> None:
    """Refuse destructive scripts unless --write was explicitly passed."""
    if write:
        return
    hit = DESTRUCTIVE.search(script)
    if hit:
        raise click.ClickException(
            f"Script contains a destructive operation ({hit.group(0)!r}); "
            f"re-run with --write to allow it."
        )


@cli.command()
@click.argument("script", required=False)
@click.option("-f", "--file", help="Read the script from a file.")
@click.option("--js", "use_js", is_flag=True, help="Interpret as JavaScript-for-Automation (JXA).")
@click.option("-w", "--write", is_flag=True, help="Allow destructive operations (delete, do shell script, …).")
def run(script: str | None, file: str | None, use_js: bool, write: bool) -> None:
    """Run an AppleScript (or JXA with --js) and print its result."""
    text = _read_script(script, file)
    _guard(text, write)
    result = _run_osascript(text, "javascript" if use_js else "applescript")
    if result.stdout:
        click.echo(result.stdout.rstrip("\n"))
    if result.returncode != 0:
        click.echo(result.stderr.rstrip("\n"), err=True)
        sys.exit(result.returncode)


@cli.command()
@click.argument("app")
@click.argument("body", required=False)
@click.option("-f", "--file", help="Read the tell-block body from a file.")
@click.option("-w", "--write", is_flag=True, help="Allow destructive operations.")
def tell(app: str, body: str | None, file: str | None, write: bool) -> None:
    """Run BODY wrapped in `tell application "APP" … end tell`.

    Convenience for the common case: `osa tell Mail "get subject of every
    message of inbox"`.
    """
    inner = _read_script(body, file)
    script = f'tell application "{app}"\n{inner}\nend tell'
    _guard(script, write)
    result = _run_osascript(script, "applescript")
    if result.stdout:
        click.echo(result.stdout.rstrip("\n"))
    if result.returncode != 0:
        click.echo(result.stderr.rstrip("\n"), err=True)
        sys.exit(result.returncode)


if __name__ == "__main__":
    cli()
